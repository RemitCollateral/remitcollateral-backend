PORT=4000
STELLAR_NETWORK=testnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org

# PostgreSQL for durable state. Unset keeps everything in memory, lost on restart.
# Local: `docker compose up -d db`, then
# DATABASE_URL=postgres://remit:remit@localhost:5432/remit
DATABASE_URL=

# Browser origins allowed to call this API, comma-separated. Unset allows
# any origin — fine for local development, not once real traffic reaches
# the API. Requests with no Origin header (server-to-server, curl, partner
# webhooks) are unaffected either way.
CORS_ALLOWED_ORIGINS=

# Soroban Contract Addresses (populated after deployment)
GUARANTOR_VAULT_CONTRACT_ID=
LOAN_LEDGER_CONTRACT_ID=
LIQUIDATION_ENGINE_CONTRACT_ID=

# Off-Ramp Partner
# Required for partner endpoints; they refuse every request while it is unset.
# Generate one, e.g. `openssl rand -hex 32`.
PARTNER_API_KEY=
# The partner's Stellar address, as registered on the LoanLedger. Loans name it
# as the partner that disburses and collects them.
PARTNER_STELLAR_ADDRESS=
# Only for a SIMULATED partner: the secret key of PARTNER_STELLAR_ADDRESS, so the
# backend can sign the partner's half of the on-chain repayment attestation. A real
# partner signs for itself; never put a real partner's key here.
PARTNER_SECRET_KEY=
# Whether MockOffRampAdapter invents a remittance history for each newly
# registered beneficiary. Off by default and should stay off anywhere real
# guarantors are quoted: seeded records count as partner_reported, carry
# full scoring weight, and so lower the collateral the protocol demands.
# Set true only for local demos.
MOCK_PARTNER_SEED_HISTORY=false

# Operator access to /admin and /audit
# The wallet allowed to use them once signed in. Leave it unset and nobody
# can: admin access fails closed.
ADMIN_WALLET_ADDRESS=G...

# The backend's on-chain roles. It holds no contract admin key: the contracts'
# admin is a multisig council. The verifier co-signs repayment attestations and
# pays the fees for liquidation cranks; the oracle publishes reputation scores.
VERIFIER_SECRET_KEY=
ORACLE_SECRET_KEY=
# Keys the hash that turns a beneficiary's phone number and KYC reference into
# their on-chain handle, so the handle cannot be reversed by guessing numbers.
# Generate once, e.g. `openssl rand -hex 32`, and never change it.
BENEFICIARY_HANDLE_SECRET=

# Wallet sign-in
# Named in the message wallets sign, so users can see where they are signing in.
AUTH_DOMAIN=RemitCollateral
# How long a session token lasts, in seconds (default 12 hours).
SESSION_TTL_SECONDS=43200

# Settlement
SETTLEMENT_ADDRESS=GSETTLEMENTADDRESS1234567890

# Scheduled Jobs
LIFECYCLE_SWEEP_INTERVAL_MINUTES=60

# How long shutdown waits for in-flight requests and a running sweep tick
# to finish before forcing exit anyway.
SHUTDOWN_TIMEOUT_MS=10000

# Rate limits
# GET /auth/challenge, by IP (default: 20 per 5 minutes).
AUTH_CHALLENGE_RATE_LIMIT_WINDOW_MINUTES=5
AUTH_CHALLENGE_RATE_LIMIT_MAX=20
# POST /repayments/attest, by partner API key (default: 60 per minute).
REPAYMENT_ATTEST_RATE_LIMIT_WINDOW_MINUTES=1
REPAYMENT_ATTEST_RATE_LIMIT_MAX=60
