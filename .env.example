PORT=4000
STELLAR_NETWORK=testnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org

# Soroban Contract Addresses (populated after deployment)
GUARANTOR_VAULT_CONTRACT_ID=
LOAN_LEDGER_CONTRACT_ID=
LIQUIDATION_ENGINE_CONTRACT_ID=

# Off-Ramp Partner
# Required for partner endpoints; they refuse every request while it is unset.
# Generate one, e.g. `openssl rand -hex 32`.
PARTNER_API_KEY=
# The partner's Stellar address, as registered on the LoanLedger. Loans name it
# as the partner that disburses and collects them.
PARTNER_STELLAR_ADDRESS=

# Operator access to /admin and /audit
# The wallet allowed to use them once signed in. Leave it unset and nobody
# can: admin access fails closed.
ADMIN_WALLET_ADDRESS=G...

# The backend's on-chain roles. It holds no contract admin key: the contracts'
# admin is a multisig council. The verifier co-signs repayment attestations and
# pays the fees for liquidation cranks; the oracle publishes reputation scores.
VERIFIER_SECRET_KEY=
ORACLE_SECRET_KEY=
# Keys the hash that turns a beneficiary's phone number and KYC reference into
# their on-chain handle, so the handle cannot be reversed by guessing numbers.
# Generate once, e.g. `openssl rand -hex 32`, and never change it.
BENEFICIARY_HANDLE_SECRET=

# Wallet sign-in
# Named in the message wallets sign, so users can see where they are signing in.
AUTH_DOMAIN=RemitCollateral
# How long a session token lasts, in seconds (default 12 hours).
SESSION_TTL_SECONDS=43200

# Settlement
SETTLEMENT_ADDRESS=GSETTLEMENTADDRESS1234567890

# Scheduled Jobs
LIFECYCLE_SWEEP_INTERVAL_MINUTES=60
