{
  "name": "remitcollateral-backend",
  "version": "1.0.0",
  "description": "RemitCollateral Backend — Crypto-collateralized lending for local beneficiaries who never touch crypto",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "test": "NODE_ENV=test node --import tsx --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "attest": "tsx scripts/attest.ts",
    "test:chain": "NODE_ENV=test node --import tsx --test \"src/**/*.chain-test.ts\"",
    "test:load": "NODE_ENV=test node --import tsx --test \"src/**/*.load-test.ts\""
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^17.1.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "pg": "^8.11.5",
    "pino": "^10.4.0",
    "prom-client": "^15.1.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.7",
    "@types/pg": "^8.11.5",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.23.13",
    "typescript": "^5.4.5"
  }
}
